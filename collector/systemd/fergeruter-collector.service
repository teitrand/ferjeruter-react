# Innsamlaren: Entur Vehicle Positions (1136, 1135, 1049, 1069) til SQLite i /var/lib/fergeruter.
# Installert av collector/deploy/install.sh. Sjå docs/innsamlar.md.
[Unit]
Description=Fergeruter innsamlar (Entur sanntid til SQLite)
Documentation=https://github.com/teitrand/ferjeruter-react/blob/main/docs/innsamlar.md
Wants=network-online.target
After=network-online.target time-sync.target
# Aldri gje opp: RestartSec under held omstartane minst 15 s frå kvarandre,
# så ein krasjløkke aldri opnar meir enn fire tilkoplingar i minuttet mot Entur.
StartLimitIntervalSec=0

[Service]
Type=simple
User=fergeruter
Group=fergeruter
WorkingDirectory=/opt/fergeruter/app/collector
EnvironmentFile=/etc/fergeruter/collector.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node bin/collector.mjs
Restart=always
RestartSec=15
TimeoutStopSec=20

# Lagring
StateDirectory=fergeruter
StateDirectoryMode=0750
ReadWritePaths=/var/lib/fergeruter
UMask=0027

# Herding. Node treng skrivbart+køyrbart minne til JIT, så MemoryDenyWriteExecute står av.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
MemoryMax=300M
TasksMax=64

[Install]
WantedBy=multi-user.target
