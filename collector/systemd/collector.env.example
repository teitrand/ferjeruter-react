# /etc/fergeruter/collector.env (root:fergeruter, 0640). Alle verdiar har standardar.
# Linjer og lagring
#FERGERUTER_LINES=1136,1135,1049,1069
#FERGERUTER_STATE_DIR=/var/lib/fergeruter
#FERGERUTER_RETENTION_DAYS=30
# Lokal status på 127.0.0.1 (curl -s localhost:8787/status). 0 = av.
#FERGERUTER_HTTP_PORT=8787
# «rest» tvingar REST-polling (berre feilsøking). Standard er straum med REST som reserve.
#FERGERUTER_MODE=stream

# Avsendar til Cloudflare-workeren: AV. Ikkje slå på før workeren er godkjend og deploya.
# Krev alle tre. Nøkkelen står berre her, aldri i repoet eller loggen.
FERGERUTER_SENDER_ENABLED=0
# Grunn-URL til workeren; innsamlaren legg til /v1/events og /v1/heartbeat.
#FERGERUTER_SENDER_URL=
#FERGERUTER_SENDER_KEY=

# AIS frå BarentsWatch Live AIS (docs/ais.md): AV. Krev FERGERUTER_AIS_ENABLED=1, klient-ID og passord.
# Passordet står berre her på serveren, aldri i repoet, chatten eller loggen.
FERGERUTER_AIS_ENABLED=0
#FERGERUTER_AIS_CLIENT_ID=<e-post>:fergeruter-innsamlar
#FERGERUTER_AIS_CLIENT_SECRET=
# MMSI:linje. Standard: M/F Kvernes (1136), M/F Geiranger (1135) og M/F Dryna (1049, verifisert 10. okt.).
#FERGERUTER_AIS_MMSI=257297400:1136,257262400:1135,258408000:1049
