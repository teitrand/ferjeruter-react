# Signaltur-sjekken: éi køyring skriv signalloggen til sanntid-workeren. Startar frå fergeruter-signaltur.timer.
# Installert av collector/deploy/install.sh. Sjå docs/signaltur-heimeserver.md.
[Unit]
Description=Fergeruter signaltur-sjekk (loggen til workeren)
Documentation=https://github.com/teitrand/ferjeruter-react/blob/main/docs/signaltur-heimeserver.md
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=fergeruter
Group=fergeruter
WorkingDirectory=/opt/fergeruter/app
# Same fil som innsamlaren: FERGERUTER_SENDER_KEY (og eventuelt FERGERUTER_SENDER_URL). Nøkkelen blir aldri skriven ut.
EnvironmentFile=/etc/fergeruter/collector.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 scripts/signaltur_server.py
TimeoutStartSec=3min
Nice=10

# Lagring
StateDirectory=fergeruter
StateDirectoryMode=0750
ReadWritePaths=/var/lib/fergeruter
UMask=0027

# Herding som for innsamlaren (MemoryDenyWriteExecute er ikkje sett).
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
MemoryMax=200M
TasksMax=64

