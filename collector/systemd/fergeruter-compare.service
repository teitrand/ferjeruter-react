# Nattleg samanlikning: innsamlaren mot tripStatus og signalloggen. Startar frå fergeruter-compare.timer.
# Installert av collector/deploy/install.sh. Sjå docs/innsamlar.md.
[Unit]
Description=Fergeruter nattleg samanlikning
Documentation=https://github.com/teitrand/ferjeruter-react/blob/main/docs/innsamlar.md
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=fergeruter
Group=fergeruter
WorkingDirectory=/opt/fergeruter/app/collector
EnvironmentFile=/etc/fergeruter/collector.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node bin/compare.mjs
TimeoutStartSec=15min
Nice=10

# Lagring
StateDirectory=fergeruter
StateDirectoryMode=0750
ReadWritePaths=/var/lib/fergeruter
UMask=0027

# Herding. Node treng skrivbart+køyrbart minne til JIT, så MemoryDenyWriteExecute står av.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
MemoryMax=300M
TasksMax=64

